---
// Burbuja sonriente de Go.Codev. `animada` activa el saludo y el parpadeo.
const { animada = false, modo = 'blanca', etiqueta } = Astro.props;
const c =
  modo === 'blanca'
    ? { sombra: '#4C1D95', cuerpo: '#FFFFFF', cara: '#7C3AED', mejilla: '#DDD6FE' }
    : modo === 'morada'
      ? { sombra: '#2E1065', cuerpo: '#7C3AED', cara: '#FFFFFF', mejilla: '#C4B5FD' }
      : { sombra: '#4C1D95', cuerpo: '#A78BFA', cara: '#2E1065', mejilla: '#DDD6FE' };
---

<svg
  viewBox="0 0 124 124"
  class:list={['mascota', { animada }]}
  role={etiqueta ? 'img' : undefined}
  aria-label={etiqueta}
  aria-hidden={etiqueta ? undefined : 'true'}
>
  <g class="m-cuerpo">
    <g fill={c.sombra} transform="translate(6 6)">
      <rect x="4" y="4" width="100" height="88" rx="32"></rect>
      <path d="M26 86 L16 112 L50 90 Z"></path>
    </g>
    <g fill={c.cuerpo}>
      <rect x="4" y="4" width="100" height="88" rx="32"></rect>
      <path d="M26 86 L16 112 L50 90 Z"></path>
    </g>
    <ellipse class="m-mejilla" cx="22" cy="58" rx="6" ry="4" fill={c.mejilla} opacity="0.85"></ellipse>
    <ellipse class="m-mejilla" cx="86" cy="58" rx="6" ry="4" fill={c.mejilla} opacity="0.85"></ellipse>
    <g
      class="m-ojos"
      fill="none"
      stroke={c.cara}
      stroke-width="8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="28,26 42,38 28,50"></polyline>
      <polyline points="80,26 66,38 80,50"></polyline>
    </g>
    <path
      d="M38 58 Q54 76 70 58"
      fill="none"
      stroke={c.cara}
      stroke-width="8"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </g>
</svg>
