---
import '@fontsource/fredoka/500.css';
import '@fontsource/fredoka/600.css';
import '@fontsource/fredoka/700.css';
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/700.css';
import '../styles/global.css';
import { sitio, datosPendientes } from '../data/sitio';

const falta = datosPendientes();
if (falta.length) {
  console.warn(
    `\n⚠️  Go.Codev: todavía hay datos de ejemplo (${falta.join(', ')}). Edítalos en src/data/sitio.ts antes de publicar.\n`
  );
}

const { titulo = sitio.titulo, descripcion = sitio.descripcion } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#7C3AED" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/logos/foto-perfil-redes-1024.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <div class="progreso" aria-hidden="true"></div>
    <slot />

    <script>
      // Animaciones de aparición al hacer scroll
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -6% 0px' }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
